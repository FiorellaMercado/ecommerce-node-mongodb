extends ../layout

block content
    h1 Productos

    a(href="/productos/nuevo") Nuevo producto
    
    table
        thead 
            tr 
                th Nombre 
                th Categoria 
                th Precio 
                th Stock 
                th Estado 
                th Acciones
        tbody
            each prod in productos 
                tr 
                    td= prod.nombre
                    td= prod.categoria
                    td= prod.precio
                    td= prod.stock
                    td= prod.activo ? 'Activo' : 'Inactivo'
                    td
                        a(href=`/productos/${prod._id}/editar`) Editar
            else 
                tr 
                    td(colspan="6") No hay prodcutos todavia